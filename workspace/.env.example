BACKEND_IMAGE=mapkeeper-backend:local
BACKEND_PORT=8000

# Backend runtime settings. Compose passes these into the backend container.
# PostgreSQL runs on a separate Proxmox LXC; the async driver is required.
DATABASE_URL=postgresql+asyncpg://mapkeeper:change-me@10.0.0.10:5432/mapkeeper
# MVP has no login. Approvals are attributed to this fixed UUID.
MVP_ACTOR_ID=00000000-0000-4000-8000-000000000000
# Log every SQL statement. Keep off so no query text leaks.
DB_ECHO=false
FRONTEND_IMAGE=mapkeeper-frontend:local
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
VITE_API_BASE_URL=
VITE_API_MOCKING=false
VITE_MOCK_SCENARIO=default
VITE_SHOW_DEVELOPER_TOOLS=false
