BACKEND_IMAGE=mapkeeper-backend:local
BACKEND_PORT=8000

# Backend runtime settings. Compose passes these into the backend container.
# PostgreSQL runs on a separate Proxmox LXC; the async driver is required.
DATABASE_URL=postgresql+asyncpg://mapkeeper:change-me@10.0.0.10:5432/mapkeeper
# MVP has no login. Approvals are attributed to this fixed UUID.
MVP_ACTOR_ID=00000000-0000-4000-8000-000000000000
# Require Firebase ID Token verification for deployed API requests.
FIREBASE_AUTH_REQUIRED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-admin.json
FIREBASE_CREDENTIALS_HOST_PATH=/srv/mapkeeper/secrets/firebase-admin.json
# Log every SQL statement. Keep off so no query text leaks.
DB_ECHO=false
# Optional Gemini model access. Keep the API key only in the VM's uncommitted .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_TIMEOUT_SECONDS=20
FRONTEND_IMAGE=mapkeeper-frontend:local
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
VITE_API_BASE_URL=
VITE_API_MOCKING=false
VITE_MOCK_SCENARIO=default
VITE_SHOW_DEVELOPER_TOOLS=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
