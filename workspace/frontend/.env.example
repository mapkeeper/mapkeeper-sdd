# Empty uses the same origin and Vite's /api proxy.
VITE_API_BASE_URL=
# Enable only for local development and automated tests.
VITE_API_MOCKING=true
VITE_MOCK_SCENARIO=default
# Keep local test controls visible; the deployment image overrides this to false.
VITE_SHOW_DEVELOPER_TOOLS=true
# Active store's UUID. Mocked development falls back to the fixture UUID when unset; local
# mock-off and real-backend runs must set this explicitly (no store-discovery API exists).
VITE_STORE_PROFILE_ID=11111111-1111-4111-8111-111111111111
