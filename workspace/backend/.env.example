# PostgreSQL runs on a separate Proxmox LXC; no DB container is added to Compose.
# The async driver is required: mapkeeper.core.config rejects any other scheme.
DATABASE_URL=postgresql+asyncpg://mapkeeper:change-me@10.0.0.10:5432/mapkeeper

# Log every SQL statement. Keep off outside local debugging so no query text leaks.
DB_ECHO=false
